# Gemini API key (https://aistudio.google.com/apikey)
# The server reads GEMINI_API_KEY, falling back to API_KEY for legacy compatibility.
GEMINI_API_KEY=your-key-here

# Optional — each unlocks that provider's models in the picker.
# Without a key the provider is hidden entirely rather than erroring.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# NVIDIA_API_KEY=

# Optional overrides
# PORT=8080
# MODEL_CHAT=gemini-3.5-flash
# MODEL_CODING=gemini-3.5-flash
# MODEL_BUILDER=gemini-3.7-flash
