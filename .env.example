# Gemini API key (https://aistudio.google.com/apikey)
# The server reads GEMINI_API_KEY, falling back to API_KEY for legacy compatibility.
GEMINI_API_KEY=your-key-here

# Optional — each unlocks that provider's models in the picker.
# Without a key the provider is hidden entirely rather than erroring.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# NVIDIA_API_KEY=

# Optional overrides
# PORT=8080
# MODEL_CHAT=gemini-3.5-flash
# MODEL_CODING=gemini-3.5-flash
# MODEL_BUILDER=gemini-3.7-flash

# --- Authentication and exposure -------------------------------------------
# Everything below is optional, and the four Google values are all-or-nothing:
# authentication is enforced only when every one of them is set, because a login
# screen with a missing piece behind it is worse than no login screen at all.
# `npm run check:auth` asserts each of these refusals by name.

# Where to listen. Loopback by default: this process holds live provider keys, writes
# files, and runs Python, so it is not exposed unless you say so. Binding anything
# else without complete auth below makes the server refuse to start.
# HOST=0.0.0.0

# Google OAuth 2.0 — https://console.cloud.google.com/apis/credentials
# The redirect URI must match what you registered there, exactly.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8050/api/auth/google/callback

# Signs session cookies. At least 32 characters, and never the placeholder in
# auth/config.js — a default that works is a key anyone reading this repo can forge with.
#   openssl rand -hex 32
# JWT_SECRET=

# Who may sign in. Empty means EVERY Google account, so it is treated as a
# misconfiguration rather than a default. Comma-separated.
# ALLOWED_EMAILS=you@example.com

# Browser origins allowed to call the API with credentials. Defaults to the Vite dev
# server and this server's own port. A wildcard is not available on purpose.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8050

# GitHub is optional and mounted only when both values are set. It signs sessions with
# the same secret under the same cookie name as Google, so its own allowlist is
# mandatory — without it, any GitHub account would bypass ALLOWED_EMAILS entirely.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ALLOWED_GITHUB_USERS=your-github-login
