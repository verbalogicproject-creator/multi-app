{
  "name": "gemini-multimodal-chat",
  "version": "1.0.0",
  "description": "Gemini multimodal chat + app builder (Vite/React client, Express proxy backend).",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "dev:server": "node --watch server.js",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "curl -sf http://localhost:8080/healthz"
  },
  "dependencies": {
    "@google/genai": "^2.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "1.4.5-lts.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^4.3.1",
    "jszip": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.13"
  }
}
